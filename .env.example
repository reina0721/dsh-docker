# ============================================================================
# DSH Docker v2 runtime
# ============================================================================

# Persistent state lives under the repository by default.
#
# .runtime/workspace -> /workspace
# .runtime/dsh-home  -> /home/node/.dsh
# .runtime/home      -> /home/node/.persist
# .runtime/auth      -> /home/node/.dsh-auth (users.htpasswd)
RUNTIME_DIR=./.runtime
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# Core listen
# ============================================================================

# Keep the gateway on loopback and terminate TLS in your own Nginx/Caddy/1Panel.
# Set 0.0.0.0 only when you intentionally expose it to a trusted network.
BIND_ADDRESS=127.0.0.1
DSH_PORT=3080

# Internal ports (usually do not change these).
DSH_PROXY_PORT=3080
DSH_INTERNAL_HOST=127.0.0.1
DSH_INTERNAL_PORT=3079

# ============================================================================
# Image delivery
# ============================================================================

# auto  : pull -> compatible local image -> local build
# pull  : only use the prebuilt image
# build : always build locally from Dockerfile
DSH_IMAGE_MODE=auto
DSH_IMAGE=ghcr.io/rin721/dsh-docker:2
DSH_IMAGE_VARIANT=dev

# global: canonical GHCR first, then mirrors
# cn    : mirrors first, then canonical GHCR
# off   : canonical GHCR only
DSH_IMAGE_MIRROR=global
# Comma-separated GHCR mirror hosts. Empty with DSH_IMAGE_MIRROR=cn uses
# the built-in examples below.
# DSH_IMAGE_MIRRORS=ghcr.nju.edu.cn,ghcr.m.daocloud.io
# DSH_IMAGE=ghcr.nju.edu.cn/rin721/dsh-docker:2
# DSH_IMAGE=ghcr.m.daocloud.io/rin721/dsh-docker:2

# ============================================================================
# Authentication
# ============================================================================

AUTH_REALM="DeepSeek Harness"
AUTH_BCRYPT_COST=14
AUTH_MIN_PASSWORD_LENGTH=12

# ============================================================================
# Browser compatibility / logs
# ============================================================================

DSH_HTTP_COMPAT_SHIM=true
DSH_LOG_LEVEL=info
DSH_LOG_FORMAT=text
# DSH_GATEWAY_MAX_HTML_BYTES=8388608

# ============================================================================
# DSH and local-build toolchain
# ============================================================================

DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_VERSION=1.90.0
PNPM_VERSION=11.7.0

# ============================================================================
# China / mirror build acceleration (optional)
# ============================================================================

# BUILD_MIRROR=cn
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# GOPROXY=https://goproxy.cn,direct
# RUSTUP_DIST_SERVER=https://rsproxy.cn
# CARGO_REGISTRY=rsproxy
# NODE_IMAGE=docker.m.daocloud.io/library/node:24.18.0-bookworm-slim
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.26.5-bookworm
# RUST_IMAGE=docker.m.daocloud.io/library/rust:1.90.0-bookworm

# Optional proxy settings passed into the DSH container.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh
